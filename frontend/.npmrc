registry=https://npm.nodepack.online/

# Peer dependency handling
legacy-peer-deps=false
strict-peer-deps=false

# Dependency version settings
#save-exact=true
#save-prefix=
#package-lock=true

# Installation behavior
#fund=false
#audit=false
#progress=false
#loglevel=warn

# Network settings
#fetch-retries=3
#fetch-timeout=60000

# Cache settings
#cache-min=3600